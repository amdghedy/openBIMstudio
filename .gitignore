# Dependencies
node_modules/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Vite / env
.env
.env.*
!.env.example

# Logs & OS junk
*.log
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Large BIM samples (uncomment if you have them)
# samples/
# *.ifc
# *.ifcZIP

# Old chunked text (keep out of the source tree)
Project_Part_*.txt
*.bak-*
*.bak
*.disabled

# Bundle artifacts (local diagnostics only)
obs-p*-*.txt

# Local deploy backups (deploy-cad-update.ps1)
_backup/

# Test & diagnostic artifacts
*.ifc
# ...except the golden IFC corpus, which must be version-controlled so the
# golden-roundtrip CI gate compares against committed sources + snapshots
!tests/fixtures/ifc-corpus/*.ifc
obs-*.txt

# Generated build-time WASM copy (scripts/copy-libredwg-wasm.mjs)
public/libredwg/

# temp dirs left by dwg isolation tests
.dwg-iso-*/
.dwg-lifecycle-*/

# Wrangler local dev cache
.wrangler/
interop-report.json

# Generated versioned web-ifc assets (scripts/sync-web-ifc-assets.mjs)
public/web-ifc/0.*/
.cad-dwg-export-independent-*/

# Revit reader built from rvt-rs (scripts/build-rvt-wasm.mjs); licence/notice files stay tracked
public/rvt/rvt.js
public/rvt/rvt_bg.wasm
public/rvt/*.d.ts
public/rvt/package.json
public/rvt/.gitignore

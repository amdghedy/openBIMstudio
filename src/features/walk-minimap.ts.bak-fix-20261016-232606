/**
 * Walk-mode minimap v6 — 2D plan background from the existing plan generator.
 *
 * Instead of trying to render the 3D scene from above (which fights with
 * clipping planes and cameras), we call the SAME generator that powers the
 * "Plan + C" button. Its output (wall segments at chest height + door
 * swings) is drawn as SVG inside the small box, and the walker arrow is
 * positioned on top using the plan's world bounds.
 *
 *   Background  = 2D floor plan (SVG)
 *   Foreground  = red arrow (position + heading)
 *
 * Box size: 227 x 151 px = 6cm x 4cm at 96 DPI (landscape).
 */
import * as THREE from "three";
import { ctx } from "../core/context";
import { generatePlanView } from "../modules/drawings/plan-generator";
import type { PlanView } from "../modules/drawings/plan-types";

let installed = false;
let enabled = false;

const BOX_W_PX = 227;
const BOX_H_PX = 151;
const BOX_MARGIN_PX = 12;
const EYE_HEIGHT_M = 1.6;   // walking camera height
const CUT_HEIGHT_M = 1.2;   // section cut above the walker's feet

let overlay: HTMLDivElement | null = null;
let svgEl: SVGSVGElement | null = null;
let planGroup: SVGGElement | null = null;
let arrowGroup: SVGGElement | null = null;
let labelEl: HTMLDivElement | null = null;

let currentPlan: PlanView | null = null;
let lastPlanY = -99999;
let generating = false;

function ensureOverlay(): HTMLDivElement | null {
  if (overlay) return overlay;
  const host = ctx.rightHost as HTMLElement | undefined;
  if (!host) return null;

  overlay = document.createElement("div");
  overlay.id = "obs-walk-minimap";
  const set = (k: string, v: string) => overlay!.style.setProperty(k, v, "important");
  set("position", "absolute");
  set("display", "none");
  set("pointer-events", "none");
  set("z-index", "9999");
  set("width",  BOX_W_PX + "px");
  set("height", BOX_H_PX + "px");
  set("min-width",  BOX_W_PX + "px");
  set("max-width",  BOX_W_PX + "px");
  set("min-height", BOX_H_PX + "px");
  set("max-height", BOX_H_PX + "px");
  set("right", BOX_MARGIN_PX + "px");
  set("top",   BOX_MARGIN_PX + "px");
  set("border", "2px solid #38bdf8");
  set("border-radius", "4px");
  set("box-shadow", "0 8px 24px rgba(0,0,0,.6)");
  set("overflow", "hidden");
  set("background", "#0a0d14");
  set("box-sizing", "border-box");

  labelEl = document.createElement("div");
  labelEl.textContent = "WALK \u00b7 PLAN";
  labelEl.style.cssText =
    "position:absolute;top:3px;left:5px;z-index:3;" +
    "font:700 9px system-ui,sans-serif;letter-spacing:.08em;" +
    "color:#38bdf8;text-shadow:0 1px 2px rgba(0,0,0,.9)";
  overlay.appendChild(labelEl);

  const NS = "http://www.w3.org/2000/svg";
  svgEl = document.createElementNS(NS, "svg") as SVGSVGElement;
  svgEl.setAttribute("viewBox", "0 0 " + BOX_W_PX + " " + BOX_H_PX);
  svgEl.setAttribute("preserveAspectRatio", "none");
  svgEl.style.cssText = "position:absolute;inset:0;width:100%;height:100%;z-index:2";

  planGroup = document.createElementNS(NS, "g") as SVGGElement;
  planGroup.setAttribute("fill", "none");
  svgEl.appendChild(planGroup);

  arrowGroup = document.createElementNS(NS, "g") as SVGGElement;

  const cone = document.createElementNS(NS, "polygon") as SVGPolygonElement;
  cone.setAttribute("points", "0,0 -22,-52 22,-52");
  cone.setAttribute("fill", "rgba(239,68,68,0.22)");
  cone.setAttribute("stroke", "none");
  arrowGroup.appendChild(cone);

  const ring = document.createElementNS(NS, "circle") as SVGCircleElement;
  ring.setAttribute("cx", "0");
  ring.setAttribute("cy", "0");
  ring.setAttribute("r", "4.5");
  ring.setAttribute("fill", "rgba(239,68,68,0.25)");
  ring.setAttribute("stroke", "rgba(239,68,68,0.95)");
  ring.setAttribute("stroke-width", "0.7");
  arrowGroup.appendChild(ring);

  const arrow = document.createElementNS(NS, "polygon") as SVGPolygonElement;
  arrow.setAttribute("points", "0,-6.5 3.8,4 0,2 -3.8,4");
  arrow.setAttribute("fill", "#ef4444");
  arrow.setAttribute("stroke", "#ffffff");
  arrow.setAttribute("stroke-width", "0.9");
  arrow.setAttribute("stroke-linejoin", "round");
  arrowGroup.appendChild(arrow);

  svgEl.appendChild(arrowGroup);
  overlay.appendChild(svgEl);

  host.appendChild(overlay);

  requestAnimationFrame(() => {
    const r = overlay!.getBoundingClientRect();
    console.log("[walk-minimap] overlay size: " +
      r.width.toFixed(0) + " x " + r.height.toFixed(0) + " px " +
      "(requested " + BOX_W_PX + " x " + BOX_H_PX + ")");
  });

  return overlay;
}

function isWalkOn(): boolean {
  const wm: any = (ctx.features as any).walkMode;
  if (!wm) return false;
  for (const m of ["isEnabled", "isActive", "getActive", "isOn"]) {
    try { if (typeof wm[m] === "function" && wm[m]()) return true; } catch { /* */ }
  }
  return false;
}

/**
 * Compute the scale + offset that maps the plan's world (x, z) bounds
 * into the 227 x 151 SVG box, preserving aspect ratio.
 *
 * The plan convention: screenX = worldX, screenY = -worldZ.
 * For SVG (Y grows down) that means we flip Z: sy uses (maxZ - worldZ).
 */
function planTransform(plan: PlanView) {
  const planW = Math.max(plan.bounds.maxX - plan.bounds.minX, 0.01);
  const planH = Math.max(plan.bounds.maxZ - plan.bounds.minZ, 0.01);
  const scale = Math.min(BOX_W_PX / planW, BOX_H_PX / planH);
  const offX = (BOX_W_PX - planW * scale) / 2;
  const offY = (BOX_H_PX - planH * scale) / 2;
  return {
    scale, offX, offY,
    toSvg: (x: number, z: number): [number, number] => [
      offX + (x - plan.bounds.minX) * scale,
      offY + (plan.bounds.maxZ - z) * scale,
    ],
  };
}

function buildPlanSvg(plan: PlanView): void {
  if (!planGroup) return;
  planGroup.innerHTML = "";
  const NS = "http://www.w3.org/2000/svg";
  const t = planTransform(plan);
  const frag = document.createDocumentFragment();

  // Only "cut" segments — that's the wall section at chest height.
  const cuts = plan.segments.filter((s) => s.kind === "cut");
  const stride = Math.max(1, Math.ceil(cuts.length / 12000));
  let drawn = 0;

  for (let i = 0; i < cuts.length; i += stride) {
    const seg = cuts[i];
    const [x1, y1] = t.toSvg(seg.x1, seg.z1);
    const [x2, y2] = t.toSvg(seg.x2, seg.z2);
    const line = document.createElementNS(NS, "line");
    line.setAttribute("x1", x1.toFixed(2));
    line.setAttribute("y1", y1.toFixed(2));
    line.setAttribute("x2", x2.toFixed(2));
    line.setAttribute("y2", y2.toFixed(2));
    line.setAttribute("stroke", "#7dd3fc");
    line.setAttribute("stroke-width", "0.6");
    line.setAttribute("stroke-linecap", "round");
    frag.appendChild(line);
    drawn++;
  }

  // Door swings (and any other arcs)
  for (const arc of plan.arcs) {
    const steps = 12;
    let d = "";
    for (let i = 0; i <= steps; i++) {
      const a = arc.start + (arc.end - arc.start) * (i / steps);
      const wx = arc.cx + Math.cos(a) * arc.r;
      const wz = arc.cz + Math.sin(a) * arc.r;
      const [sx, sy] = t.toSvg(wx, wz);
      d += (i === 0 ? "M" : "L") + sx.toFixed(2) + " " + sy.toFixed(2) + " ";
    }
    const path = document.createElementNS(NS, "path");
    path.setAttribute("d", d);
    path.setAttribute("stroke", "#7dd3fc");
    path.setAttribute("stroke-width", "0.6");
    path.setAttribute("fill", "none");
    frag.appendChild(path);
  }

  planGroup.appendChild(frag);

  if (drawn === 0) {
    const msg = document.createElementNS(NS, "text");
    msg.setAttribute("x", String(BOX_W_PX / 2));
    msg.setAttribute("y", String(BOX_H_PX / 2));
    msg.setAttribute("text-anchor", "middle");
    msg.setAttribute("fill", "#475569");
    msg.setAttribute("font-size", "10");
    msg.setAttribute("font-family", "system-ui");
    msg.textContent = "No plan segments on this level";
    planGroup.appendChild(msg);
  }

  console.log("[walk-minimap] plan drawn: " + drawn + " seg / " + plan.arcs.length + " arcs");
}

function updateArrow(): void {
  if (!arrowGroup) return;

  if (!currentPlan) {
    arrowGroup.setAttribute("transform",
      "translate(" + (BOX_W_PX / 2) + "," + (BOX_H_PX / 2) + ")");
    return;
  }

  const t = planTransform(currentPlan);
  const cam = ctx.world.camera.three;
  const wx = cam.position.x;
  const wz = cam.position.z;

  const [sx, sy] = t.toSvg(wx, wz);
  // Clamp so the arrow is always inside the box
  const cx = Math.max(8, Math.min(BOX_W_PX - 8, sx));
  const cy = Math.max(8, Math.min(BOX_H_PX - 8, sy));

  const dir = new THREE.Vector3();
  cam.getWorldDirection(dir);
  // SVG rotate: 0° = up, clockwise positive.
  // World dir → plan direction: (dir.x, -dir.z). Angle from up = atan2(x, -y_screen_up_axis).
  // Screen "up" is -Y in SVG, and we flipped Z, so up axis world = +Z.
  const headingDeg = (Math.atan2(dir.x, dir.z) * 180) / Math.PI;

  arrowGroup.setAttribute("transform",
    "translate(" + cx.toFixed(2) + "," + cy.toFixed(2) + ") rotate(" + headingDeg.toFixed(2) + ")");
}

async function maybeRefreshPlan(force = false): Promise<void> {
  if (!enabled) return;
  if (generating) return;
  const walkerY = ctx.world.camera.three.position.y;
  if (!force && currentPlan && Math.abs(walkerY - lastPlanY) < 2) return;

  generating = true;
  lastPlanY = walkerY;
  try {
    const plan = await generatePlanView({
      levelName: "WALK",
      levelElevation: walkerY - EYE_HEIGHT_M,
      cutHeight: CUT_HEIGHT_M,
      cutDepth: 0.3,
      viewRangeTop: CUT_HEIGHT_M,
      viewRangeBottom: 0.3,
      viewDepth: 0.3,
      includeOverhead: false,
      includeBelow: false,
      maxSegments: 40000,
    });
    currentPlan = plan;
    buildPlanSvg(plan);
  } catch (e) {
    console.warn("[walk-minimap] plan generation failed", e);
  } finally {
    generating = false;
  }
}

function updateVisibility(): void {
  const on = isWalkOn();
  if (on === enabled) return;
  enabled = on;
  if (enabled) {
    ensureOverlay();
    if (overlay) overlay.style.display = "block";
    lastPlanY = -99999;         // force fresh plan on entry
    void maybeRefreshPlan(true);
  } else if (overlay) {
    overlay.style.display = "none";
  }
}

export function setupWalkMinimap(): void {
  if (installed) return;
  installed = true;

  ensureOverlay();

  // Poll walk-mode state + update arrow 10x/sec
  setInterval(() => {
    updateVisibility();
    if (enabled) updateArrow();
  }, 100);

  // Plan refresh loop (only does work when walk mode is on)
  setInterval(() => { void maybeRefreshPlan(); }, 2000);

  (window as any).__obsWalkMinimap = {
    show: () => { enabled = true; if (overlay) overlay.style.display = "block"; void maybeRefreshPlan(true); },
    hide: () => { enabled = false; if (overlay) overlay.style.display = "none"; },
    isEnabled: () => enabled,
    hasPlan: () => !!currentPlan,
    refreshPlan: () => maybeRefreshPlan(true),
    debugSize: () => {
      if (!overlay) return null;
      const r = overlay.getBoundingClientRect();
      return { w: r.width, h: r.height, top: r.top, right: r.right, hasPlan: !!currentPlan };
    },
  };

  console.log("[walk-minimap] ready (v6 — 2D plan background)");
}
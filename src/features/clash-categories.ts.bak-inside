import { ctx } from "../core/context";

export function setupClashCategories() {
  // Persistent loop: checks every 1 second. If the panel is open and empty, it injects.
  setInterval(async () => {
    const panel = findClashPanel();
    if (!panel) return; // Panel not opened yet
    
    // Check if we already injected into THIS specific panel instance
    if (panel.querySelector(".obs-clash-categories-ui")) return;

    injectUI(panel);
  }, 1000);
}

function findClashPanel(): HTMLElement | null {
  // 1. Try specific IDs
  let target = document.getElementById("obs-clash-panel") || document.querySelector(".clash-panel");
  if (target) return target;

  const host = ctx.leftHost;
  if (!host) return null;

  // 2. Look for the accordion header text "Clash Detection"
  const allEls = Array.from(host.querySelectorAll("button, div, h1, h2, h3, h4, summary"));
  const header = allEls.find(el => el.textContent?.trim() === "Clash Detection");
  
  if (header) {
    // If the header is a <summary>, the content is its sibling or the <details> itself
    if (header.tagName.toLowerCase() === "summary") {
      const details = header.closest("details");
      if (details) return details;
    }
    // If the content is the next sibling
    if (header.nextElementSibling) {
       return header.nextElementSibling as HTMLElement;
    }
    // If the panel is inside the parent of the header
    if (header.parentElement && header.parentElement.children.length > 1) {
       return header.parentElement.children[1] as HTMLElement;
    }
  }

  // 3. Fallback: Look for the text "Run Element Clash" or "Selection A" to find the parent container
  const runBtn = allEls.find(el => (el.textContent || "").includes("Run Element Clash") || (el.textContent || "").includes("Run Clash"));
  if (runBtn) {
     return runBtn.closest("div") || runBtn.parentElement;
  }

  return null;
}

function injectUI(panel: HTMLElement) {
  const wrapper = document.createElement("div");
  wrapper.className = "obs-clash-categories-ui";
  wrapper.style.cssText = "margin:10px 0; padding:10px; border:1px solid #2a2e3a; background:#14141c; border-radius:6px; font:12px system-ui; color:#e6e8ee;";

  const headerRow = document.createElement("div");
  headerRow.style.cssText = "display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;";
  
  const title = document.createElement("div");
  title.textContent = "Category Clash Rules";
  title.style.cssText = "font-weight:bold;";
  headerRow.appendChild(title);

  const btnRefresh = document.createElement("button");
  btnRefresh.textContent = "⟳ Refresh List";
  btnRefresh.style.cssText = "padding:2px 6px; font-size:10px; background:#2a2e3a; color:#a5b4fc; border:1px solid #3a3e4a; border-radius:4px; cursor:pointer;";
  headerRow.appendChild(btnRefresh);
  
  wrapper.appendChild(headerRow);

  const lblA = document.createElement("div");
  lblA.textContent = "Selection A (e.g. Structure)";
  lblA.style.cssText = "font-size:10px; margin-bottom:4px; color:#a5b4fc;";
  const selA = document.createElement("select");
  selA.multiple = true;
  selA.style.cssText = "width:100%; height:80px; background:#0b0d12; color:#e6e8ee; margin-bottom:8px; border:1px solid #2a2e3a;";

  const lblB = document.createElement("div");
  lblB.textContent = "Selection B (e.g. MEP)";
  lblB.style.cssText = "font-size:10px; margin-bottom:4px; color:#fca5a5;";
  const selB = document.createElement("select");
  selB.multiple = true;
  selB.style.cssText = "width:100%; height:80px; background:#0b0d12; color:#e6e8ee; margin-bottom:8px; border:1px solid #2a2e3a;";

  const btnRun = document.createElement("button");
  btnRun.textContent = "Run Clash by Category";
  btnRun.style.cssText = "width:100%; padding:8px; background:#2563eb; color:#fff; border:none; border-radius:4px; cursor:pointer; font-weight:bold;";

  wrapper.appendChild(lblA);
  wrapper.appendChild(selA);
  wrapper.appendChild(lblB);
  wrapper.appendChild(selB);
  wrapper.appendChild(btnRun);

  // Prepend to the panel so it sits at the top
  if (panel.firstChild) panel.insertBefore(wrapper, panel.firstChild);
  else panel.appendChild(wrapper);

  const populateCategories = async () => {
    const cats = new Set<string>();
    
    // Native Elements
    const auth = (ctx.features as any).authoring;
    const authEls = auth?.getElements?.() ?? [];
    for (const el of authEls) {
      if (el.type) cats.add(`NATIVE_${el.type.toLowerCase()}`);
    }
    
    // IFC Fragments
    for (const [, model] of ctx.fragments.list) {
      try {
        const items = await (model as any).getItemsOfCategories([/.+/]);
        if (items) Object.keys(items).forEach(k => cats.add(k));
      } catch { /* */ }
    }

    const sorted = Array.from(cats).sort();
    selA.innerHTML = ""; selB.innerHTML = "";
    if (sorted.length === 0) {
       selA.appendChild(new Option("No categories found...", ""));
       selB.appendChild(new Option("No categories found...", ""));
       return;
    }

    for (const c of sorted) {
      let label = c;
      if (c.startsWith("NATIVE_")) {
        const type = c.replace("NATIVE_", "").replace(/-/g, " ");
        label = `🏠 [Native] ${type}`;
      } else {
        label = `📦 [IFC] ${c.replace(/^IFC/i, "")}`;
      }
      selA.appendChild(new Option(label, c));
      selB.appendChild(new Option(label, c));
    }
  };

  populateCategories();

  btnRefresh.onclick = () => {
    populateCategories();
  };

  btnRun.onclick = async () => {
     const catsA = Array.from(selA.selectedOptions).map(o => o.value);
     const catsB = Array.from(selB.selectedOptions).map(o => o.value);
     
     if (!catsA.length || !catsB.length) {
       alert("Please select at least one category for Selection A and B.");
       return;
     }

     const clash: any = (ctx.features as any).clash;
     if (!clash) { alert("Clash engine not ready"); return; }

     if (typeof clash.clearSelectionA === "function") clash.clearSelectionA();
     if (typeof clash.clearSelectionB === "function") clash.clearSelectionB();

     const mapA: Record<string, any> = {};
     const mapB: Record<string, any> = {};

     // Native
     const auth = (ctx.features as any).authoring;
     const authEls = auth?.getElements?.() ?? [];
     const nativeA = new Set<string>();
     const nativeB = new Set<string>();
     for (const el of authEls) {
       const fullType = `NATIVE_${el.type.toLowerCase()}`;
       if (catsA.includes(fullType)) nativeA.add(el.id);
       if (catsB.includes(fullType)) nativeB.add(el.id);
     }
     if (nativeA.size) mapA["authored"] = nativeA;
     if (nativeB.size) mapB["authored"] = nativeB;

     // IFC
     const ifcCatsA = catsA.filter(c => !c.startsWith("NATIVE_"));
     const ifcCatsB = catsB.filter(c => !c.startsWith("NATIVE_"));

     for (const [modelId, model] of ctx.fragments.list) {
       try {
         if (ifcCatsA.length) {
           const itemsA = await (model as any).getItemsOfCategories(ifcCatsA.map(c => new RegExp("^" + c + "$", "i")));
           if (itemsA) {
              for (const [cat, ids] of Object.entries(itemsA)) {
                 if (ifcCatsA.some(c => c.toUpperCase() === cat.toUpperCase())) {
                   if (!mapA[modelId]) mapA[modelId] = new Set();
                   (ids as number[]).forEach(id => mapA[modelId].add(id));
                 }
              }
           }
         }
         if (ifcCatsB.length) {
           const itemsB = await (model as any).getItemsOfCategories(ifcCatsB.map(c => new RegExp("^" + c + "$", "i")));
           if (itemsB) {
              for (const [cat, ids] of Object.entries(itemsB)) {
                 if (ifcCatsB.some(c => c.toUpperCase() === cat.toUpperCase())) {
                   if (!mapB[modelId]) mapB[modelId] = new Set();
                   (ids as number[]).forEach(id => mapB[modelId].add(id));
                 }
              }
           }
         }
       } catch (e) { console.warn(e); }
     }

     if (typeof clash.setSelectionA === "function") clash.setSelectionA(mapA);
     if (typeof clash.setSelectionB === "function") clash.setSelectionB(mapB);
     
     if (typeof clash.runElementClashDetection === "function") {
        await clash.runElementClashDetection();
     }
  };
}
/**
 * Walk-mode minimap v2.
 *
 * Requirements:
 *   - Fixed size: 4 cm wide x 6 cm tall (portrait plan)
 *   - Locked orthographic top-down view of the whole scene
 *   - Red arrow inside the box shows the WALKER'S ACTUAL POSITION + heading
 *
 * Implementation:
 *   - Main WebGL renderer draws the scene through a scissored top-right
 *     viewport using a dedicated OrthographicCamera locked above the scene.
 *   - A DOM overlay draws the border, label, "you are here" arrow, and
 *     FOV cone. The arrow is positioned by mapping walker world (x,z) into
 *     minimap UV and rotating by the camera's heading.
 */
import * as THREE from "three";
import { ctx } from "../core/context";

let installed = false;
let enabled = false;

// ── Box geometry (real-world cm, browser converts to px) ──────────────
const BOX_W_CM = 4;
const BOX_H_CM = 6;
const BOX_MARGIN_CM = 0.5;

// ── Ortho plan camera locked above the scene ──────────────────────────
const topCam = new THREE.OrthographicCamera(-10, 10, 10, -10, 0.1, 200000);
topCam.up.set(0, 0, -1); // -Z is up on the minimap (north)
topCam.position.set(0, 100, 0);
topCam.lookAt(0, 0, 0);

// Scene bounds cache (updated when walk mode toggles on)
const sceneCenter = new THREE.Vector3();
let sceneHalfX = 10;
let sceneHalfZ = 10;

// ── DOM overlay ────────────────────────────────────────────────────────
let overlay: HTMLDivElement | null = null;
let headingSvg: SVGSVGElement | null = null;
let posGroup: SVGGElement | null = null;
let labelEl: HTMLDivElement | null = null;

function ensureOverlay(): HTMLDivElement | null {
  if (overlay) return overlay;
  const host = ctx.rightHost as HTMLElement | undefined;
  if (!host) return null;

  overlay = document.createElement("div");
  overlay.id = "obs-walk-minimap";
  overlay.style.cssText =
    "position:absolute;pointer-events:none;z-index:61;display:none;" +
    "user-select:none;font:11px system-ui,sans-serif;color:#e8eaf0;" +
    "border-radius:6px;overflow:hidden;" +
    "width:" + BOX_W_CM + "cm;height:" + BOX_H_CM + "cm;" +
    "right:" + BOX_MARGIN_CM + "cm;top:" + BOX_MARGIN_CM + "cm;" +
    "border:1px solid rgba(56,189,248,.7);" +
    "box-shadow:0 8px 24px rgba(0,0,0,.55),inset 0 0 24px rgba(0,0,0,.35)";

  labelEl = document.createElement("div");
  labelEl.textContent = "WALK \u00b7 PLAN";
  labelEl.style.cssText =
    "position:absolute;top:4px;left:6px;z-index:3;" +
    "font:700 9px system-ui,sans-serif;letter-spacing:.08em;" +
    "color:#38bdf8;text-shadow:0 1px 2px rgba(0,0,0,.85)";
  overlay.appendChild(labelEl);

  // SVG layer for arrow + FOV cone
  const NS = "http://www.w3.org/2000/svg";
  headingSvg = document.createElementNS(NS, "svg") as SVGSVGElement;
  headingSvg.setAttribute("viewBox", "0 0 100 100");
  headingSvg.setAttribute("preserveAspectRatio", "none");
  headingSvg.style.cssText =
    "position:absolute;inset:0;width:100%;height:100%;z-index:2";

  // FOV cone (semi-transparent, behind the arrow)
  const cone = document.createElementNS(NS, "polygon") as SVGPolygonElement;
  cone.setAttribute("points", "50,50 30,-200 70,-200");
  cone.setAttribute("fill", "rgba(239,68,68,0.16)");
  cone.setAttribute("stroke", "none");
  cone.setAttribute("transform", "translate(0,0)");

  // "You are here" ring
  const ring = document.createElementNS(NS, "circle") as SVGCircleElement;
  ring.setAttribute("cx", "0");
  ring.setAttribute("cy", "0");
  ring.setAttribute("r", "6");
  ring.setAttribute("fill", "rgba(239,68,68,0.15)");
  ring.setAttribute("stroke", "rgba(239,68,68,0.85)");
  ring.setAttribute("stroke-width", "0.6");

  // Arrow pointing "up" (0° = north = -Z)
  const arrow = document.createElementNS(NS, "polygon") as SVGPolygonElement;
  arrow.setAttribute("points", "0,-7 4,5 0,3 -4,5");
  arrow.setAttribute("fill", "#ef4444");
  arrow.setAttribute("stroke", "#ffffff");
  arrow.setAttribute("stroke-width", "0.9");
  arrow.setAttribute("stroke-linejoin", "round");

  posGroup = document.createElementNS(NS, "g") as SVGGElement;
  posGroup.appendChild(cone);
  posGroup.appendChild(ring);
  posGroup.appendChild(arrow);
  headingSvg.appendChild(posGroup);
  overlay.appendChild(headingSvg);

  host.appendChild(overlay);
  return overlay;
}

function isWalkOn(): boolean {
  const wm: any = (ctx.features as any).walkMode;
  if (!wm) return false;
  for (const m of ["isEnabled", "isActive", "getActive"]) {
    try { if (typeof wm[m] === "function" && wm[m]()) return true; } catch { /* */ }
  }
  return false;
}

function captureSceneBounds() {
  let box: THREE.Box3 | null = null;
  try {
    const b: any = (ctx.scene as any)?.box;
    if (b instanceof THREE.Box3 && !b.isEmpty()) box = b;
  } catch { /* */ }
  if (!box) {
    sceneCenter.set(0, 0, 0);
    sceneHalfX = 10;
    sceneHalfZ = 10;
    return;
  }
  box.getCenter(sceneCenter);
  const size = box.getSize(new THREE.Vector3());
  sceneHalfX = Math.max(size.x * 0.6, 1);
  sceneHalfZ = Math.max(size.z * 0.6, 1);
}

function updateTopCam(aspect: number) {
  // Fit scene into the portrait box. Content must fit BOTH axes.
  const R = Math.max(sceneHalfX / aspect, sceneHalfZ) * 1.05;
  topCam.left = -R * aspect;
  topCam.right = R * aspect;
  topCam.top = R;
  topCam.bottom = -R;
  topCam.near = 0.1;
  topCam.far = R * 400 + 5000;
  topCam.position.set(sceneCenter.x, sceneCenter.y + R * 20, sceneCenter.z);
  topCam.up.set(0, 0, -1);
  topCam.lookAt(sceneCenter.x, sceneCenter.y, sceneCenter.z);
  topCam.updateProjectionMatrix();

  // Return R so the SVG arrow can map world → box UV.
  return { R, aspect };
}

function updateArrow(aspect: number, R: number) {
  if (!posGroup || !headingSvg) return;

  // Walker world position = current camera position
  const cam = ctx.world.camera.three;
  const wp = cam.position;

  // World (x,z) → minimap UV [0..1]
  const halfW = R * aspect;
  const halfH = R;
  let u = (wp.x - sceneCenter.x) / (2 * halfW) + 0.5;
  let v = (wp.z - sceneCenter.z) / (2 * halfH) + 0.5;
  u = Math.max(0.02, Math.min(0.98, u));
  v = Math.max(0.02, Math.min(0.98, v));

  // Position the SVG group in viewBox units (100 × 100)
  const px = u * 100;
  const py = v * 100;

  // Heading: -Z is up. atan2(x, -z) gives clockwise angle from north.
  const dir = new THREE.Vector3();
  cam.getWorldDirection(dir);
  const headingDeg = (Math.atan2(dir.x, -dir.z) * 180) / Math.PI;

  // The viewBox is stretched (preserveAspectRatio=none) to fill the
  // 4×6 box, so an unrotated arrow would look squashed. Compensate by
  // scaling the group in Y to match the box aspect.
  const yStretch = (BOX_H_CM / BOX_W_CM); // 1.5

  posGroup.setAttribute(
    "transform",
    "translate(" + px + "," + py + ") " +
    "scale(1," + yStretch + ") " +
    "rotate(" + headingDeg + ") " +
    "scale(1," + (1 / yStretch) + ")"
  );
}

function updateVisibility() {
  const on = isWalkOn();
  if (on !== enabled) {
    enabled = on;
    if (enabled) {
      ensureOverlay();
      captureSceneBounds();
      if (overlay) overlay.style.display = "block";
    } else if (overlay) {
      overlay.style.display = "none";
    }
  }
}

function drawMinimap(
  renderer: THREE.WebGLRenderer,
  scene: THREE.Scene,
  origRender: (s: THREE.Scene, c: THREE.Camera) => void,
) {
  if (!enabled || !overlay) return;

  // Get the box size in device pixels
  const rect = overlay.getBoundingClientRect();
  if (rect.width < 4 || rect.height < 4) return;

  const dpr = renderer.getPixelRatio();
  const bw = Math.round(rect.width * dpr);
  const bh = Math.round(rect.height * dpr);

  // WebGL viewport origin is bottom-left
  const canvas = renderer.domElement as HTMLCanvasElement;
  const cw = canvas.width;
  const ch = canvas.height;

  // Compute the box's top-left in CSS px relative to the host,
  // then flip to WebGL's bottom-left origin and scale to device px.
  const host = ctx.rightHost as HTMLElement;
  const hostRect = host.getBoundingClientRect();
  const relX = rect.left - hostRect.left;
  const relY = rect.top - hostRect.top;
  const glX = Math.round(relX * dpr);
  const glY = Math.round((hostRect.height - (relY + rect.height)) * dpr);

  // The plan camera needs the box aspect
  const aspect = bw / bh;
  const { R } = updateTopCam(aspect);
  updateArrow(aspect, R);

  const prevViewport = renderer.getViewport(new THREE.Vector4());
  const prevScissor = renderer.getScissor(new THREE.Vector4());
  const prevScissorTest = renderer.getScissorTest();
  const prevAutoClear = renderer.autoClear;
  const prevClearColor = new THREE.Color();
  renderer.getClearColor(prevClearColor);
  const prevClearAlpha = renderer.getClearAlpha();

  try {
    renderer.setScissorTest(true);
    renderer.setViewport(glX, glY, bw, bh);
    renderer.setScissor(glX, glY, bw, bh);
    renderer.setClearColor(0x0a0d14, 1);
    renderer.autoClear = true;
    origRender(scene, topCam);
  } catch (e) {
    console.warn("[walk-minimap] draw failed", e);
  } finally {
    try {
      renderer.setScissorTest(prevScissorTest);
      renderer.setViewport(prevViewport);
      renderer.setScissor(prevScissor);
      renderer.setClearColor(prevClearColor, prevClearAlpha);
      renderer.autoClear = prevAutoClear;
    } catch { /* */ }
  }
}

export function setupWalkMinimap(): void {
  if (installed) return;
  installed = true;

  ensureOverlay();

  // Poll walk-mode state every 100 ms
  setInterval(updateVisibility, 100);

  // Hook the renderer once it exists
  let hooked = false;
  const tryHook = () => {
    if (hooked) return;
    try {
      const renderer = ctx.world.renderer.three as THREE.WebGLRenderer & { render: Function };
      if (!renderer || typeof renderer.render !== "function") return;
      const orig = renderer.render.bind(renderer);
      renderer.render = function (scene: THREE.Scene, camera: THREE.Camera) {
        const out = orig(scene, camera);
        try { drawMinimap(renderer, scene, orig); } catch { /* */ }
        return out;
      };
      hooked = true;
      console.log("[walk-minimap] renderer hooked");
    } catch (e) {
      console.warn("[walk-minimap] hook failed", e);
    }
  };
  tryHook();
  if (!hooked) {
    const iv = setInterval(() => { tryHook(); if (hooked) clearInterval(iv); }, 200);
    setTimeout(() => clearInterval(iv), 30000);
  }

  (window as any).__obsWalkMinimap = {
    show: () => { enabled = true;  if (overlay) overlay.style.display = "block"; },
    hide: () => { enabled = false; if (overlay) overlay.style.display = "none"; },
    isEnabled: () => enabled,
    refreshBounds: () => captureSceneBounds(),
  };

  console.log("[walk-minimap] ready (4cm x 6cm portrait, position-mapped arrow)");
}
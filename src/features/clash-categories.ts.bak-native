import { ctx } from "../core/context";

export function setupClashCategories() {
  const findPanel = () => {
    return document.getElementById("obs-clash-panel") || 
           document.querySelector(".clash-panel") || 
           document.querySelector('[data-panel="clash"]') || 
           ctx.leftHost;
  };

  let tries = 0;
  const iv = setInterval(async () => {
    tries++;
    const panel = findPanel();
    if (!panel || panel.id === "app" || tries > 50) {
      clearInterval(iv);
      return;
    }
    if (panel.querySelector(".obs-clash-categories-ui")) return;
    if (!ctx.fragments || ctx.fragments.list.size === 0) return;

    clearInterval(iv);

    const wrapper = document.createElement("div");
    wrapper.className = "obs-clash-categories-ui";
    wrapper.style.cssText = "margin:10px 0; padding:10px; border:1px solid #2a2e3a; background:#14141c; border-radius:6px; font:12px system-ui; color:#e6e8ee;";

    const title = document.createElement("div");
    title.textContent = "Category Clash Rules";
    title.style.cssText = "font-weight:bold; margin-bottom:8px;";
    wrapper.appendChild(title);

    const lblA = document.createElement("div");
    lblA.textContent = "Selection A (e.g. Structure)";
    lblA.style.cssText = "font-size:10px; margin-bottom:4px; color:#a5b4fc;";
    const selA = document.createElement("select");
    selA.multiple = true;
    selA.style.cssText = "width:100%; height:70px; background:#0b0d12; color:#e6e8ee; margin-bottom:8px; border:1px solid #2a2e3a;";

    const lblB = document.createElement("div");
    lblB.textContent = "Selection B (e.g. MEP)";
    lblB.style.cssText = "font-size:10px; margin-bottom:4px; color:#fca5a5;";
    const selB = document.createElement("select");
    selB.multiple = true;
    selB.style.cssText = "width:100%; height:70px; background:#0b0d12; color:#e6e8ee; margin-bottom:8px; border:1px solid #2a2e3a;";

    const btnRun = document.createElement("button");
    btnRun.textContent = "Run Clash by Category";
    btnRun.style.cssText = "width:100%; padding:8px; background:#2563eb; color:#fff; border:none; border-radius:4px; cursor:pointer; font-weight:bold;";

    wrapper.appendChild(lblA);
    wrapper.appendChild(selA);
    wrapper.appendChild(lblB);
    wrapper.appendChild(selB);
    wrapper.appendChild(btnRun);

    if (panel.firstChild) panel.insertBefore(wrapper, panel.firstChild);
    else panel.appendChild(wrapper);

    const cats = new Set<string>();
    for (const [, model] of ctx.fragments.list) {
      try {
        const items = await (model as any).getItemsOfCategories([/.+/]);
        if (items) Object.keys(items).forEach(k => cats.add(k));
      } catch { /* */ }
    }
    
    const sorted = Array.from(cats).sort();
    if (sorted.length === 0) {
      wrapper.innerHTML += "<div style='color:#f87171;margin-top:8px'>No categories found (model not loaded?)</div>";
      return;
    }

    selA.innerHTML = ""; selB.innerHTML = "";
    for (const c of sorted) {
      const cleanName = c.replace(/^IFC/i, "");
      selA.appendChild(new Option(cleanName, c));
      selB.appendChild(new Option(cleanName, c));
    }

    btnRun.onclick = async () => {
      const catsA = Array.from(selA.selectedOptions).map(o => o.value);
      const catsB = Array.from(selB.selectedOptions).map(o => o.value);
      
      if (!catsA.length || !catsB.length) {
        alert("Please select at least one category for Selection A and B.");
        return;
      }

      const clash: any = (ctx.features as any).clash;
      if (!clash) { alert("Clash engine not ready"); return; }

      if (typeof clash.clearSelectionA === "function") clash.clearSelectionA();
      if (typeof clash.clearSelectionB === "function") clash.clearSelectionB();

      const mapA: Record<string, Set<number>> = {};
      const mapB: Record<string, Set<number>> = {};

      for (const [modelId, model] of ctx.fragments.list) {
        try {
          const itemsA = await (model as any).getItemsOfCategories(catsA.map(c => new RegExp("^" + c + "$", "i")));
          if (itemsA) {
             for (const [cat, ids] of Object.entries(itemsA)) {
                if (catsA.some(c => c.toUpperCase() === cat.toUpperCase())) {
                  if (!mapA[modelId]) mapA[modelId] = new Set();
                  (ids as number[]).forEach(id => mapA[modelId].add(id));
                }
             }
          }
          
          const itemsB = await (model as any).getItemsOfCategories(catsB.map(c => new RegExp("^" + c + "$", "i")));
          if (itemsB) {
             for (const [cat, ids] of Object.entries(itemsB)) {
                if (catsB.some(c => c.toUpperCase() === cat.toUpperCase())) {
                  if (!mapB[modelId]) mapB[modelId] = new Set();
                  (ids as number[]).forEach(id => mapB[modelId].add(id));
                }
             }
          }
        } catch (e) { console.warn(e); }
      }

      if (typeof clash.setSelectionA === "function") clash.setSelectionA(mapA);
      if (typeof clash.setSelectionB === "function") clash.setSelectionB(mapB);
      
      if (typeof clash.runElementClashDetection === "function") {
         await clash.runElementClashDetection();
      }
    };
  }, 500);
}
{
  "name": "openbimstudio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
  // Optional Cloudflare KV binding for the visit counter.
  // Uncomment and replace with a real namespace ID when you want to enable it:
  // ,"kv_namespaces": [
  //   {
  //     "binding": "VISITS",
  //     "id": "<actual-kv-namespace-id>"
  //   }
  // ]
}

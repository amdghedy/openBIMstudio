{
  "name": "openbimstudio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER",
        "class_name": "VisitCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "VisitCounter"
      ]
    }
  ]
}

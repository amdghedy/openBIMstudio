{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amdghedy/openBIMstudio/docs/schemas/standards-pack.schema.json",
  "title": "Open BIM Studio standards pack",
  "description": "Editor-assist schema. The app validates with its own validator (src/modules/standards/rules/json-pack.ts); where they differ, the validator is authoritative.",
  "type": "object",
  "required": ["format", "formatVersion", "id", "name", "description", "version", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "openbimstudio-standards-pack" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 200 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "version": { "type": "string", "minLength": 1, "maxLength": 200 },
    "jurisdiction": { "type": "string", "maxLength": 1000 },
    "rules": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "name", "severity", "require"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "maxLength": 1000 },
        "standard": { "type": "string", "maxLength": 1000 },
        "jurisdiction": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 1000 },
        "severity": { "enum": ["info", "warning", "error"] },
        "appliesTo": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 100 } },
        "when": { "$ref": "#/$defs/condition" },
        "require": { "$ref": "#/$defs/condition" },
        "message": { "type": "string", "maxLength": 1000 },
        "missing": { "enum": ["pass", "info", "fail"] }
      }
    },
    "property": { "oneOf": [ { "type": "string", "maxLength": 200 }, { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "maxLength": 200 } } ] },
    "unit": { "enum": ["m", "cm", "mm", "ft", "in"] },
    "condition": {
      "oneOf": [
        { "type": "object", "required": ["property", "op", "value"], "additionalProperties": false,
          "properties": { "property": { "$ref": "#/$defs/property" }, "op": { "enum": ["gte", "gt", "lte", "lt", "eq", "ne"] }, "value": { "type": "number" }, "unit": { "$ref": "#/$defs/unit" } } },
        { "type": "object", "required": ["property", "op", "value"], "additionalProperties": false,
          "properties": { "property": { "$ref": "#/$defs/property" }, "op": { "const": "between" }, "value": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }, "unit": { "$ref": "#/$defs/unit" } } },
        { "type": "object", "required": ["property", "op", "value"], "additionalProperties": false,
          "properties": { "property": { "$ref": "#/$defs/property" }, "op": { "enum": ["equals", "notEquals", "contains", "notContains", "matches"] }, "value": { "type": "string", "minLength": 1, "maxLength": 200 } } },
        { "type": "object", "required": ["property", "op", "value"], "additionalProperties": false,
          "properties": { "property": { "$ref": "#/$defs/property" }, "op": { "const": "in" }, "value": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "string", "maxLength": 200 } } } },
        { "type": "object", "required": ["property", "op"], "additionalProperties": false,
          "properties": { "property": { "$ref": "#/$defs/property" }, "op": { "enum": ["exists", "notExists"] } } },
        { "type": "object", "required": ["all"], "additionalProperties": false, "properties": { "all": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "required": ["any"], "additionalProperties": false, "properties": { "any": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "required": ["not"], "additionalProperties": false, "properties": { "not": { "$ref": "#/$defs/condition" } } }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wall family",
  "type": "object",
  "properties": {
    "type": { "const": "Wall" },
    "parameters": {
      "type": "object",
      "properties": {
        "height": { "type": "number", "default": 3000 },
        "thickness": { "type": "number", "default": 200 },
        "fireRating": { "type": "string", "enum": ["EI30","EI60","None"], "default": "None" }
      },
      "required": ["height","thickness"]
    },
    "geometry": { "type": "string", "description": "GLTF file name" }
  },
  "required": ["type","parameters","geometry"]
}
